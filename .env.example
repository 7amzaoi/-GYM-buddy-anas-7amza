# GymBuddy — environment template
# Copy this file to `.env.local` (gitignored) and fill in the real values.

# Supabase project URL and anon (public) key.
# Find them at: https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
